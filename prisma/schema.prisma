// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String          @id @default(uuid())
  name              String
  contact           String          @unique
  passwordHash      String?
  preferredLanguage String          @default("English")
  createdAt         DateTime        @default(now())
  profile           CitizenProfile?
  applications      Application[]
}

model CitizenProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  state             String
  district          String
  incomeBand        String
  occupation        String
  householdSize     Int
  primaryNeed       String
  hasAadhaar        Boolean  @default(false)
  hasBankAccount    Boolean  @default(false)
  completionPercent Int      @default(0)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Scheme {
  id           String              @id @default(uuid())
  slug         String              @unique
  category     String
  state        String
  ministry     String
  translations SchemeTranslation[]
  requirements SchemeRequirement[]
  applications Application[]
}

model SchemeTranslation {
  id       String @id @default(uuid())
  schemeId String
  language String // e.g., "English", "हिन्दी", "বাংলা", "தமிழ்", "తెలుగు"
  title    String
  benefit  String
  amount   String
  deadline String
  scheme   Scheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, language])
}

model SchemeRequirement {
  id           String                         @id @default(uuid())
  schemeId     String
  kind         String // "eligibility" or "document"
  scheme       Scheme                         @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  translations SchemeRequirementTranslation[]
}

model SchemeRequirementTranslation {
  id            String            @id @default(uuid())
  requirementId String
  language      String // e.g., "English", "हिन्दी", "বাংলা", "தமிழ்", "తెలుగు"
  label         String
  requirement   SchemeRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, language])
}

model Application {
  id        String   @id @default(uuid())
  userId    String
  schemeId  String
  status    String   // "draft", "submitted", "under_review", "approved", "rejected"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheme    Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
}

